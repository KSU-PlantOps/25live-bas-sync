# Keep the build context small and never leak local config/secrets into the
# image. (The Dockerfile only COPYs main.py, bassync/, the entrypoint, and the
# requirement/constraint files, but this also speeds up builds.)
.git
.gitignore
.github
.idea
.venv
venv
__pycache__
*.py[cod]
*.bak

# Local, site-specific config & secrets — mounted at runtime, not built in.
.env
config.yaml
defaults.yaml
space_mapping.yaml
config/
logs/
state/
*.log

# Not needed at runtime
editor.py
Edit-Rooms.bat
Test.py
tests/
.pytest_cache
.ruff_cache
.mypy_cache
*.md
docs/
LICENSE
