# Secrets and container settings for docker compose. Copy to .env (gitignored):
#   cp .env.example .env
# Passwords live ONLY here / in the environment — never in the YAML settings.
# Every variable in this file is passed into the container. After changing
# it, `docker compose up -d` restarts the container with the new values.

# ── The web UI ──────────────────────────────────────────────────────────────
# The local password: signs in as Admin. Use it to set up Microsoft sign-in on
# the Access page, and to get back in if that breaks. Without it (and without
# SSO) the web UI stays off and only the schedule runs. Make it long.
BAS_WEB_PASSWORD=
# Where it listens. With host networking these are the host's: set
# BAS_WEB_HOST to one address (the management NIC) rather than all of them.
BAS_WEB_HOST=0.0.0.0
BAS_WEB_PORT=8080
# Serve HTTPS with your certificate (mount it, e.g. into /config/tls/):
# BAS_WEB_TLS_CERT=/config/tls/cert.pem
# BAS_WEB_TLS_KEY=/config/tls/key.pem
# Behind a reverse proxy that terminates HTTPS, trust its X-Forwarded-* headers:
# BAS_WEB_BEHIND_PROXY=1
# Only behind a proxy that does its own login: no password at all.
# BAS_WEB_AUTH=none
# The Entra app's client secret, if you'd rather keep it here than set it on
# the Access page:
# BAS_WEB_SSO_CLIENT_SECRET=

# ── 25Live and the BAS ──────────────────────────────────────────────────────
# These can instead be set on the web UI (Connection and Alerts pages), which
# stores them in the state volume. One set here wins over one set there.
#
# The 25Live service account (a LOCAL account, not SSO).
BAS_25LIVE_PASSWORD=

# One per BAS system that logs in (the rest driver), named after the system's
# key in config.yaml, uppercased, with non-alphanumerics as underscores:
#   systems: { ebo_west: ... }     ->  BAS_SYS_EBO_WEST_PASSWORD
# BACnet systems — Niagara stations included — need no password; the controls
# network is the boundary. The web UI's Connection page lists what's missing.
# BAS_SYS_EBO_WEST_PASSWORD=

# The deprecated niagara driver's pre-1.0 password name, still honored.
# BAS_NIAGARA_PASSWORD=

# Only needed if alerts.email is enabled in config.yaml.
BAS_SMTP_PASSWORD=

# Optional: keep the webhook URL (a credential — anyone holding it can post to
# the channel) out of config.yaml.
# BAS_ALERT_WEBHOOK_URL=

# ── The container ───────────────────────────────────────────────────────────
# Campus timezone (IANA name): the container clock and its log timestamps.
# The sync and its schedule use `timezone:` in config.yaml.
TZ=America/New_York

# Run as this user/group instead of the owner of the config folder.
# PUID=1000
# PGID=1000

# 1.x settings, still honored: SYNC_AT (HH:MM) overrides the schedule's times
# and SYNC_ON_START=1 its run-on-start. Leave them out to manage the schedule
# in the web UI.
# SYNC_AT=02:00
# SYNC_ON_START=0
